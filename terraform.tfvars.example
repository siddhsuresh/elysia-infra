# Copy to terraform.tfvars and fill in your values
region         = "us-east-1"
name           = "elysia"
# suffix is appended to globally-unique resource names (ECR, IAM roles, ALB,
# CloudWatch log group, ECS cluster) to prevent ResourceAlreadyExistsException.
# Use something short and meaningful: "dev", "prod", "ss" (initials), etc.
suffix         = "dev"
vpc_cidr       = "10.0.0.0/16"
container_port = 3000
task_cpu       = 256
task_memory    = 512
desired_count  = 1

# Ravion DNS control plane demo
ravion_base_url = "http://localhost:8080"
ravion_api_key  = "<DomainProviderClaims JWT — paste output of cmd/mint-jwt>"
demo_domain     = "demo.your-controlled-domain.com"
